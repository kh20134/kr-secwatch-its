# 기본은 알림 꺼짐. 값을 채워야 해당 채널이 켜진다.
# 샘플 모드(collect/serve --demo)는 --alert 를 주지 않으면 전송하지 않는다.

SECWATCH_DEMO=0
SECWATCH_DB=data/secwatch.db
SECWATCH_INVENTORY=secwatch/assets/inventory.yaml
SECWATCH_MIN_PRIORITY=46
SECWATCH_NVD_MAX=15
SECWATCH_HTTP_TIMEOUT=20

# NVD API 키(선택). 없으면 조회 사이 간격을 둔다.
NVD_API_KEY=

# Slack Incoming Webhook. 비우면 Slack 전송 안 함.
# 호스트는 hooks.slack.com 만 허용한다.
SLACK_WEBHOOK_URL=

# 메일. SMTP_HOST, ALERT_EMAIL_FROM, ALERT_EMAIL_TO 가 모두 있어야 켜진다.
ALERT_EMAIL_FROM=
ALERT_EMAIL_TO=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_TLS=1
